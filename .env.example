# ---------------------------------------------------------------------------
# RailGPT environment configuration — COPY to .env and fill in real values.
# Never commit a real .env. All secrets below are placeholders.
# ---------------------------------------------------------------------------

# ---- Spring Boot backend (production path) ----
# PostgreSQL connection. Use a dedicated database in production.
DB_URL=jdbc:postgresql://localhost:5432/railgpt
DB_USERNAME=railgpt
DB_PASSWORD=change-me-strong-db-password        # REQUIRED — set a real password
POSTGRES_ADMIN_USER=railgpt_admin
POSTGRES_ADMIN_PASSWORD=change-me-separate-admin-db-password # Compose bootstrap only

# JWT signing secret. MUST be >= 32 bytes. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-at-least-32-bytes-long-random-secret   # REQUIRED in production
JWT_EXPIRATION_MS=3600000

# Server port for the Spring Boot backend.
SERVER_PORT=8081

# Comma-separated browser origins allowed by CORS (your frontend URL).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Set true when the backend is served over HTTPS (secure auth cookie).
COOKIE_SECURE=false

# Hibernate schema strategy. Use "validate" once you add Flyway/Liquibase.
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# OTP hashing key (required by the Spring backend, at least 32 bytes).
# Generate a unique value for each deployment; do not reuse the example text.
OTP_HASH_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# Local illustrative data only. The prod profile always disables this.
SEED_DATA_ENABLED=true

# Ticket email outbox worker; configure SMTP below for delivery.
EMAIL_OUTBOX_ENABLED=true

# Optional one-time production administrator bootstrap; remove credentials after first startup.
BOOTSTRAP_ADMIN_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# SMTP sender used for registration codes and booking ticket emails.
# For Gmail, MAIL_APP_PASSWORD must be a Google App Password (not account password).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-sender@gmail.com
MAIL_APP_PASSWORD=your-smtp-app-password

# ---- Demo API (local preview only — NOT for production) ----
DEMO_PORT=8090
DEMO_PERSIST=false
DEMO_JWT_SECRET=change-me-demo-secret            # demo only, not for production

# ---- Frontend (Vite) ----
# Which backend the dev proxy targets. The PRIMARY backend is Spring Boot (:8081),
# which is also the built-in default if this is unset.
VITE_API_TARGET=http://localhost:8081
# Optional demo fallback (illustrative data only, no Java/DB needed):
# VITE_API_TARGET=http://localhost:8090
# Base URL for the frontend live contract tests (npm run test:live):
# LIVE_API_URL=http://localhost:8081
